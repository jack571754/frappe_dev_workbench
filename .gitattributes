# 强制构建上下文里的文本文件用 LF,杜绝 Windows core.autocrlf 把 \r 带进 Linux 镜像
# CRLF 会让容器内 shell 脚本 shebang 失效,报 "cannot execute: required file not found"
# 详见 memory: psp-crlf-entrypoint-trap

# 容器入口与脚本
*.sh           text eol=lf
*.bash         text eol=lf

# nginx 配置 / 模板
*.conf         text eol=lf
*.template     text eol=lf

# 构建文件
Containerfile  text eol=lf
Dockerfile     text eol=lf
*.dockerfile   text eol=lf

# 整个构建上下文子树(兜底)
resources/**   text eol=lf
images/**      text eol=lf
