ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_IMAGE_PREFIX=frappe

FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_BRANCH} AS builder

ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""

USER frappe

# uv 全局镜像源:bench init 调用 uv 的子进程不继承 UV_INDEX_URL 环境变量,
# 改用 ~/.config/uv/uv.toml(uv 自动读取),让包从阿里云 CDN 下载,避免 files.pythonhosted.org 走代理超时
RUN mkdir -p /home/frappe/.config/uv && \
  printf '[[index]]\nurl = "https://pypi.tuna.tsinghua.edu.cn/simple/"\ndefault = true\n' \
  > /home/frappe/.config/uv/uv.toml

# bench init 在一次 RUN 里做三件联网的事:clone frappe、装 pip 依赖、跑 yarn install。
# 主要故障源是 github 连通性 —— 根因与修法见 scripts/update-frappe-only.sh:
# 必须用 --build-arg 把宿主 clash 代理传进来,否则容器直连 github 会被墙。
# 但即使代理配好,连接仍可能中途被重置,而 yarn 解析 git 依赖(frappe/air-datepicker)
# 用的是 `git ls-remote`、对 git fetch 不做任何重试 —— 一次重置就让整个 10 分钟的构建失败:
#   GnuTLS recv error (-110): The TLS connection was non-properly terminated.
# 故对 bench init 整体重试作为兜底。bench init 拒绝写入已存在的目录,每次先清理目标目录。
RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
  : "${CACHE_BUST}" && \
  git config --global http.version HTTP/1.1 && \
  git config --global http.postBuffer 524288000 && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  for attempt in 1 2 3; do \
    echo "=== bench init attempt ${attempt}/3 ===" && \
    rm -rf /home/frappe/frappe-bench && \
    if bench init ${APP_INSTALL_ARGS} \
        --frappe-branch=${FRAPPE_BRANCH} \
        --frappe-path=${FRAPPE_PATH} \
        --no-procfile \
        --no-backups \
        --skip-redis-config-generation \
        --verbose \
        /home/frappe/frappe-bench; then \
      break; \
    fi; \
    if [ "${attempt}" = "3" ]; then \
      echo "=== bench init failed after 3 attempts ==="; \
      exit 1; \
    fi; \
    echo "=== attempt ${attempt} failed, retrying in 15s ==="; \
    sleep 15; \
  done && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_BRANCH} AS backend

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

# Move assets to image-layer storage
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

# Override upstream nginx-entrypoint.sh: base:version-16 ships a CRLF copy whose
# shebang (#!/bin/bash\r) makes the kernel refuse execution -> frontend exit 127.
# COPY the local LF version and strip any stray CR as a belt-and-suspenders fix.
COPY resources/core/nginx/nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
RUN chmod 755 /usr/local/bin/nginx-entrypoint.sh && sed -i 's/\r$//' /usr/local/bin/nginx-entrypoint.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
